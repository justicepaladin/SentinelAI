DATABASE_URL=postgresql://user:password@localhost:5432/sentinel_db
TELEGRAM_BOT_TOKEN=replace_with_your_telegram_bot_token
TELEGRAM_CHAT_ID=replace_with_your_telegram_chat_id
SENTINEL_LOG_DIR=logs
SENTINEL_LOG_MAX_BYTES=52428800
SENTINEL_CRITICAL_MSE=0.000924
SENTINEL_QUARANTINE_SECONDS=60
SENTINEL_ALERT_TTL_HOURS=24
SENTINEL_ALERT_UPDATE_SECONDS=300
SENTINEL_LINK_STATE_TTL_SECONDS=120
# SHA-256 hexadecimal de un token administrador aleatorio de al menos 32 caracteres.
# SENTINEL_ADMIN_TOKEN_SHA256=

# Los sitios y sensores se crean con provision_sensor.py. El umbral MSE y la
# respuesta activa se configuran por sitio en PostgreSQL, no en este archivo.
# SENTINEL_SENSOR_TOKEN se usa sólo en Edge y no debe guardarse en el .env del backend.
